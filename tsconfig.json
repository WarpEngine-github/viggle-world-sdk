{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "@viggle/scene-sdk": ["./src/index.ts"],
      "@viggle/scene-sdk/react": ["./src/react/index.ts"],
      "@viggle/scene-sdk/viewer": ["./src/viewer/index.ts"],
      "@viggle/scene-sdk/walk": ["./src/walk/index.ts"],
      "@viggle/scene-sdk/explorer": ["./src/explorer/index.ts"],
      "@viggle/scene-sdk/lighting": ["./src/lighting/index.ts"]
    }
  },
  "include": ["src", "example"]
}
